---
import { BUSINESS } from "@/data/client";
---

<section
  id="final-cta"
  aria-labelledby="final-cta-title"
  class="bg-ink text-bone relative overflow-hidden py-20 lg:py-28"
>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 opacity-[0.08]"
    style="background-image: linear-gradient(to right, rgba(248,244,237,0.45) 1px, transparent 1px), linear-gradient(to bottom, rgba(248,244,237,0.35) 1px, transparent 1px); background-size: 84px 84px;"
  >
  </div>

  <div
    aria-hidden="true"
    class="via-bone/25 absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent to-transparent"
  >
  </div>

  <div class="relative mx-auto max-w-[88rem] px-5 lg:px-10">
    <div class="grid grid-cols-1 items-end gap-10 lg:grid-cols-12 lg:gap-14">
      <div class="lg:col-span-7">
        <p class="alf-eyebrow text-bone/70">Last Stop</p>
        <h2
          id="final-cta-title"
          class="font-display text-section-xl text-bone mt-5 max-w-[18ch] leading-[1.03]"
        >
          Ready to drive away with
          <span class="text-accent-bright italic">a better payment?</span>
        </h2>
      </div>

      <div class="lg:col-span-5">
        <p class="text-body-l text-bone/75 max-w-[31rem] lg:ml-auto">
          Compare lender options, refinance an existing loan, or get a new
          vehicle approval started with a Calgary-based advisor.
        </p>

        <div class="mt-7 flex flex-col gap-3 sm:flex-row lg:justify-end">
          <a href="#lead-form" class="alf-btn alf-btn-accent">
            Get Pre-Approved
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M5 12h14M13 5l7 7-7 7"></path>
            </svg>
          </a>
          <a
            href={`tel:${BUSINESS.phoneForTel}`}
            class="alf-btn !text-bone border-bone/30 hover:!bg-bone hover:!text-ink border !bg-transparent"
          >
            {BUSINESS.phoneFormatted}
          </a>
        </div>

        <ul class="mt-8 grid max-w-[31rem] grid-cols-3 gap-4 lg:ml-auto">
          {
            [
              { value: "60 sec", label: "Quick check" },
              { value: "No", label: "Credit pull" },
              { value: "AB", label: "Local broker" },
            ].map((item) => (
              <li class="border-bone/20 border-l pl-4">
                <span class="font-display text-content-m text-bone block leading-none">
                  {item.value}
                </span>
                <span class="text-bone/55 mt-2 block text-[0.7rem] font-semibold tracking-[0.18em] uppercase">
                  {item.label}
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
