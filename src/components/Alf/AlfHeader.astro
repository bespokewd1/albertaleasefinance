---
import navData from "@/data/navData.json";
import { BUSINESS } from "@/data/client";

const currentPath = Astro.url.pathname;
---

<header
  data-alf-header
  class="fixed inset-x-0 top-0 z-50 transition-all duration-300"
>
  <div class="alf-grain bg-bone/85 backdrop-blur-md border-b border-line-soft">
    <div class="mx-auto max-w-[88rem] px-5 lg:px-10">
      <div class="flex items-center justify-between gap-6 py-3 lg:py-4">
        <!-- Brand -->
        <a
          href="/"
          aria-label="Alberta Leasing & Financing — Home"
          class="group flex items-center gap-3 shrink-0"
        >
          <span
            class="relative inline-grid place-items-center w-11 h-11 rounded-full bg-ink text-bone font-display text-content-l leading-none transition-transform duration-300 group-hover:rotate-[-8deg]"
          >
            <span class="-mt-0.5 italic">a</span>
            <span
              class="absolute -bottom-1 -right-1 w-3 h-3 rounded-full bg-accent ring-4 ring-bone"
            ></span>
          </span>
          <span class="hidden sm:flex flex-col leading-none">
            <span
              class="font-display text-[1.0625rem] tracking-tight text-ink"
            >
              Alberta Leasing
            </span>
            <span
              class="text-[0.65rem] uppercase tracking-[0.28em] text-muted mt-1 font-medium"
            >
              & Financing · AB
            </span>
          </span>
        </a>

        <!-- Desktop nav -->
        <nav
          aria-label="Primary"
          class="hidden lg:flex items-center gap-7 mx-auto"
        >
          {
            navData.map((entry) => (
              <a
                href={entry.url}
                data-active={currentPath === entry.url ? "true" : "false"}
                class="alf-link text-[0.875rem] font-medium text-graphite hover:text-ink"
              >
                {entry.key}
              </a>
            ))
          }
        </nav>

        <!-- Right cluster -->
        <div class="flex items-center gap-2 lg:gap-4 shrink-0">
          <a
            href={`tel:${BUSINESS.phoneForTel}`}
            class="hidden xl:inline-flex items-center gap-2 text-[0.8125rem] font-medium text-graphite hover:text-ink transition-colors"
          >
            <span class="w-1.5 h-1.5 rounded-full bg-success animate-pulse"></span>
            {BUSINESS.phoneFormatted}
          </a>
          <a
            href="/#lead-form"
            class="alf-btn alf-btn-accent !py-3 !px-5 text-[0.8125rem]"
          >
            Apply Now
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14M13 5l7 7-7 7"/>
            </svg>
          </a>
          <button
            type="button"
            data-alf-nav-toggle
            data-open="false"
            aria-controls="alf-mobile-menu"
            aria-expanded="false"
            aria-label="Open menu"
            class="lg:hidden relative w-11 h-11 grid place-items-center rounded-full border border-line bg-paper text-ink"
          >
            <span class="alf-burger relative w-5 h-3.5">
              <span class="absolute left-0 right-0 top-0 h-[2px] bg-current rounded transition-transform duration-300 origin-center"></span>
              <span class="absolute left-0 right-0 top-1/2 -translate-y-1/2 h-[2px] bg-current rounded transition-opacity duration-300"></span>
              <span class="absolute left-0 right-0 bottom-0 h-[2px] bg-current rounded transition-transform duration-300 origin-center"></span>
            </span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Mobile menu panel -->
  <div
    id="alf-mobile-menu"
    data-alf-nav-menu
    data-open="false"
    class="lg:hidden fixed inset-x-0 top-[68px] bottom-0 bg-bone overflow-y-auto data-[open=false]:opacity-0 data-[open=false]:pointer-events-none data-[open=false]:translate-y-2 data-[open=true]:opacity-100 data-[open=true]:translate-y-0 transition-all duration-300"
  >
    <div class="px-6 pt-8 pb-12 max-w-[88rem] mx-auto">
      <nav aria-label="Mobile" class="flex flex-col">
        {
          navData.map((entry, i) => (
            <a
              href={entry.url}
              class="group flex items-baseline justify-between gap-4 py-5 border-b border-line-soft last:border-b-0"
            >
              <span class="font-display text-[2rem] leading-none tracking-tight text-ink group-hover:text-primary transition-colors">
                {entry.key}
              </span>
              <span class="text-[0.7rem] uppercase tracking-[0.2em] text-muted font-medium">
                0{i + 1}
              </span>
            </a>
          ))
        }
      </nav>
      <div class="mt-10 grid grid-cols-1 gap-3">
        <a href="/#lead-form" class="alf-btn alf-btn-accent w-full">
          Apply Now
        </a>
        <a href={`tel:${BUSINESS.phoneForTel}`} class="alf-btn alf-btn-ghost w-full">
          Call {BUSINESS.phoneFormatted}
        </a>
      </div>
    </div>
  </div>
</header>

<!-- Spacer to offset fixed header -->
<div aria-hidden="true" class="h-[68px] lg:h-[80px]"></div>

<style>
  [data-alf-nav-toggle][data-open="true"] .alf-burger span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  [data-alf-nav-toggle][data-open="true"] .alf-burger span:nth-child(2) {
    opacity: 0;
  }
  [data-alf-nav-toggle][data-open="true"] .alf-burger span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }
</style>

<script>
  function initAlfHeader() {
    const toggle = document.querySelector<HTMLButtonElement>(
      "[data-alf-nav-toggle]"
    );
    const menu = document.querySelector<HTMLElement>("[data-alf-nav-menu]");
    const header = document.querySelector<HTMLElement>("[data-alf-header]");
    if (!toggle || !menu || !header) return;

    const setOpen = (open: boolean) => {
      menu.dataset.open = String(open);
      toggle.dataset.open = String(open);
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      document.body.style.overflow = open ? "hidden" : "";
    };

    toggle.addEventListener("click", () => {
      setOpen(menu.dataset.open !== "true");
    });

    menu.querySelectorAll("a").forEach((a) =>
      a.addEventListener("click", () => setOpen(false))
    );

    let lastY = window.scrollY;
    const onScroll = () => {
      const y = window.scrollY;
      header.classList.toggle("shadow-[0_8px_24px_-12px_rgba(13,20,23,0.18)]", y > 12);
      lastY = y;
    };
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });

    document.addEventListener(
      "astro:before-swap",
      () => {
        document.body.style.overflow = "";
      },
      { once: true }
    );
  }

  document.addEventListener("astro:page-load", initAlfHeader);
</script>
