---
import { Picture } from "astro:assets";
import heroBg from "@/assets/images/landing.jpg";
---

<section
  id="hero"
  class="relative isolate overflow-hidden bg-ink text-bone"
>
  <!-- Background image -->
  <div class="absolute inset-0 -z-10">
    <Picture
      src={heroBg}
      alt=""
      formats={["avif", "webp"]}
      loading="eager"
      widths={[640, 960, 1280, 1920]}
      sizes="100vw"
      class="w-full h-full object-cover"
    />
    <div
      class="absolute inset-0 bg-gradient-to-r from-ink via-ink/85 to-ink/40"
    ></div>
    <div
      class="absolute inset-0 bg-gradient-to-t from-ink/90 via-transparent to-transparent"
    ></div>
  </div>

  <!-- Decorative grid lines -->
  <div
    aria-hidden="true"
    class="absolute inset-0 -z-[5] opacity-[0.06] pointer-events-none"
    style="background-image: linear-gradient(to right, white 1px, transparent 1px), linear-gradient(to bottom, white 1px, transparent 1px); background-size: 80px 80px;"
  >
  </div>

  <!-- Floating accent shape -->
  <div
    aria-hidden="true"
    class="absolute -right-32 top-1/3 -z-[4] w-[28rem] h-[28rem] rounded-full bg-accent/20 blur-3xl"
  >
  </div>

  <div class="mx-auto max-w-[88rem] px-5 lg:px-10 pt-16 lg:pt-24 pb-20 lg:pb-32">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-start">
      <!-- LEFT: Headline -->
      <div class="lg:col-span-7 xl:col-span-7">
        <div
          data-rise
          class="alf-eyebrow text-bone/80 mb-6"
          style="animation-delay: 0.05s;"
        >
          <span class="!bg-bone/80"></span>Alberta&rsquo;s Trusted Finance Partner
        </div>

        <h1
          data-rise
          style="animation-delay: 0.15s;"
          class="font-display text-hero-xxl font-medium text-bone"
        >
          Drive More.<br />
          <span class="italic font-normal text-accent-bright">Pay Less.</span>
        </h1>

        <p
          data-rise
          style="animation-delay: 0.3s;"
          class="mt-6 max-w-[34rem] text-body-l text-bone/80"
        >
          Fast vehicle financing, refinancing, and commercial leasing solutions
          tailored to your budget. Get pre-approved across Alberta in minutes —
          not days.
        </p>

        <div
          data-rise
          style="animation-delay: 0.45s;"
          class="mt-9 flex flex-wrap gap-3"
        >
          <a href="#lead-form" class="alf-btn alf-btn-accent">
            Get Pre-Approved
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14M13 5l7 7-7 7"/>
            </svg>
          </a>
          <a
            href="#calculator"
            class="alf-btn !bg-transparent !text-bone border border-bone/30 hover:!bg-bone hover:!text-ink"
          >
            Calculate Savings
          </a>
        </div>

        <!-- Trust indicators -->
        <ul
          data-rise
          style="animation-delay: 0.6s;"
          class="mt-12 grid grid-cols-2 sm:grid-cols-4 gap-x-4 gap-y-5 max-w-[40rem]"
        >
          {
            [
              { label: "Fast Approvals", sub: "< 24 hours" },
              { label: "Competitive Rates", sub: "From 4.99%" },
              { label: "All Credit Types", sub: "Yes, even rebuild" },
              { label: "Alberta Based", sub: "Local support" },
            ].map((t) => (
              <li class="flex flex-col gap-1 border-l border-bone/20 pl-4">
                <span class="flex items-center gap-1.5 text-[0.875rem] font-semibold text-bone">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-accent-bright" aria-hidden="true">
                    <polyline points="20 6 9 17 4 12"/>
                  </svg>
                  {t.label}
                </span>
                <span class="text-[0.75rem] text-bone/60 ml-[1.375rem]">
                  {t.sub}
                </span>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- RIGHT: Lead form card -->
      <div
        data-rise
        style="animation-delay: 0.4s;"
        class="lg:col-span-5 xl:col-span-5 lg:sticky lg:top-28"
        id="lead-form"
      >
        <div class="relative">
          <!-- decorative offset card -->
          <div
            aria-hidden="true"
            class="absolute -inset-3 rounded-[2rem] bg-accent/40 blur-2xl -z-10"
          >
          </div>

          <div
            class="relative bg-bone text-ink rounded-[1.75rem] p-7 sm:p-9 shadow-[0_30px_80px_-20px_rgba(0,0,0,0.4)] border border-bone-soft"
          >
            <div class="flex items-start justify-between gap-4 mb-7">
              <div>
                <p class="alf-eyebrow text-accent-deep">Quick Application</p>
                <h2 class="mt-2 font-display text-content-xl text-ink leading-[1.05]">
                  Check your options<br /> in 60 seconds.
                </h2>
              </div>
              <div
                aria-hidden="true"
                class="shrink-0 w-12 h-12 rounded-full bg-ink text-bone grid place-items-center"
              >
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14M13 5l7 7-7 7"/>
                </svg>
              </div>
            </div>

            <form
              class="space-y-4"
              data-alf-lead-form
              action="/api/lead"
              method="post"
            >
              <div>
                <label for="lead-name" class="sr-only">Full Name</label>
                <input
                  id="lead-name"
                  name="name"
                  type="text"
                  required
                  placeholder="Full name"
                  class="alf-input"
                  autocomplete="name"
                />
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                  <label for="lead-phone" class="sr-only">Phone Number</label>
                  <input
                    id="lead-phone"
                    name="phone"
                    type="tel"
                    required
                    placeholder="Phone"
                    class="alf-input"
                    autocomplete="tel"
                  />
                </div>
                <div>
                  <label for="lead-email" class="sr-only">Email</label>
                  <input
                    id="lead-email"
                    name="email"
                    type="email"
                    required
                    placeholder="Email"
                    class="alf-input"
                    autocomplete="email"
                  />
                </div>
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                  <label for="lead-vehicle" class="sr-only">Vehicle Type</label>
                  <select id="lead-vehicle" name="vehicle" required class="alf-input appearance-none bg-[url('data:image/svg+xml;utf8,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%2212%22 height=%228%22 viewBox=%220 0 12 8%22 fill=%22none%22 stroke=%22%236b665e%22 stroke-width=%221.8%22 stroke-linecap=%22round%22 stroke-linejoin=%22round%22><polyline points=%221 1 6 6 11 1%22/></svg>')] bg-[right_1rem_center] bg-no-repeat pr-10">
                    <option value="">Vehicle type</option>
                    <option value="new">New vehicle</option>
                    <option value="used">Used vehicle</option>
                    <option value="refinance">Refinance existing</option>
                    <option value="commercial">Commercial / fleet</option>
                  </select>
                </div>
                <div>
                  <label for="lead-credit" class="sr-only">Credit Range</label>
                  <select id="lead-credit" name="credit" required class="alf-input appearance-none bg-[url('data:image/svg+xml;utf8,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%2212%22 height=%228%22 viewBox=%220 0 12 8%22 fill=%22none%22 stroke=%22%236b665e%22 stroke-width=%221.8%22 stroke-linecap=%22round%22 stroke-linejoin=%22round%22><polyline points=%221 1 6 6 11 1%22/></svg>')] bg-[right_1rem_center] bg-no-repeat pr-10">
                    <option value="">Credit range</option>
                    <option value="excellent">Excellent (740+)</option>
                    <option value="good">Good (670–739)</option>
                    <option value="fair">Fair (580–669)</option>
                    <option value="rebuild">Rebuilding (&lt; 580)</option>
                  </select>
                </div>
              </div>

              <button type="submit" class="alf-btn alf-btn-primary w-full mt-2">
                Check My Options
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M5 12h14M13 5l7 7-7 7"/>
                </svg>
              </button>

              <p class="text-[0.75rem] text-muted flex items-center gap-2 justify-center pt-1">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <rect x="3" y="11" width="18" height="11" rx="2"/>
                  <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                </svg>
                No obligation · Secure SSL application
              </p>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom curve transition -->
  <div
    aria-hidden="true"
    class="absolute bottom-0 inset-x-0 h-12 bg-bone"
    style="clip-path: polygon(0 100%, 100% 100%, 100% 0, 0 60%);"
  >
  </div>
</section>
