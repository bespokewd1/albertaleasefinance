---
import { Picture } from "astro:assets";
import heroBg from "@/assets/images/cars/car2.webp";
---

<section id="hero" class="bg-ink text-surface relative isolate overflow-hidden">
  <!-- Background image -->
  <div class="absolute inset-0 -z-10">
    <Picture
      src={heroBg}
      alt=""
      formats={["avif", "webp"]}
      loading="eager"
      widths={[640, 960, 1280, 1920]}
      sizes="100vw"
      class="h-full w-full object-cover"
    />
    <div
      class="from-ink via-ink/85 to-ink/40 absolute inset-0 bg-gradient-to-r"
    >
    </div>
    <div
      class="from-ink/90 absolute inset-0 bg-gradient-to-t via-transparent to-transparent"
    >
    </div>
  </div>

  <!-- Decorative grid lines -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 -z-[5] opacity-[0.06]"
    style="background-image: linear-gradient(to right, white 1px, transparent 1px), linear-gradient(to bottom, white 1px, transparent 1px); background-size: 80px 80px;"
  >
  </div>

  <!-- Floating accent shape -->
  <div
    aria-hidden="true"
    class="bg-accent/20 absolute top-1/3 -right-32 -z-[4] h-[28rem] w-[28rem] rounded-full blur-3xl"
  >
  </div>

  <div
    class="mx-auto max-w-[88rem] px-5 pt-16 pb-20 lg:px-10 lg:pt-24 lg:pb-32"
  >
    <div class="grid grid-cols-1 items-start gap-10 lg:grid-cols-12 lg:gap-12">
      <!-- LEFT: Headline -->
      <div class="lg:col-span-7 xl:col-span-7">
        <div
          data-rise
          class="alf-eyebrow text-surface/80 mb-6"
          style="animation-delay: 0.05s;"
        >
          <span class="!bg-surface/80"></span>Alberta&rsquo;s Trusted Finance
          Partner
        </div>

        <h1
          data-rise
          style="animation-delay: 0.15s;"
          class="font-display text-hero-xxl text-surface font-medium"
        >
          Drive More.<br />
          <span class="text-accent-bright font-normal italic">Pay Less.</span>
        </h1>

        <p
          data-rise
          style="animation-delay: 0.3s;"
          class="text-body-l text-surface/80 mt-6 max-w-[34rem]"
        >
          Fast vehicle financing, refinancing, and commercial leasing solutions
          tailored to your budget. Get pre-approved across Alberta in minutes —
          not days.
        </p>

        <div
          data-rise
          style="animation-delay: 0.45s;"
          class="mt-9 flex flex-wrap gap-3"
        >
          <a href="#lead-form" class="alf-btn alf-btn-accent">
            Get Pre-Approved
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M5 12h14M13 5l7 7-7 7"></path>
            </svg>
          </a>
          <a
            href="#calculator"
            class="alf-btn !text-surface border-surface/30 hover:!bg-surface hover:!text-ink border !bg-transparent"
          >
            Calculate Savings
          </a>
        </div>

        <!-- Trust indicators -->
        <ul
          data-rise
          style="animation-delay: 0.6s;"
          class="mt-12 grid max-w-[40rem] grid-cols-2 gap-x-4 gap-y-5 sm:grid-cols-4"
        >
          {
            [
              { label: "Fast Approvals", sub: "< 24 hours" },
              { label: "Competitive Rates", sub: "From 4.99%" },
              { label: "All Credit Types", sub: "Yes, even rebuild" },
              { label: "Alberta Based", sub: "Local support" },
            ].map((t) => (
              <li class="border-surface/20 flex flex-col gap-1 border-l pl-4">
                <span class="text-surface flex items-center gap-1.5 text-[0.875rem] font-semibold">
                  <svg
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="text-accent-bright"
                    aria-hidden="true"
                  >
                    <polyline points="20 6 9 17 4 12" />
                  </svg>
                  {t.label}
                </span>
                <span class="text-surface/60 ml-[1.375rem] text-[0.75rem]">
                  {t.sub}
                </span>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- RIGHT: Lead form card -->
      <div
        data-rise
        style="animation-delay: 0.4s;"
        class="lg:sticky lg:top-28 lg:col-span-5 xl:col-span-5"
        id="lead-form"
      >
        <div class="relative">
          <!-- decorative offset card -->
          <div
            aria-hidden="true"
            class="bg-accent/40 absolute -inset-3 -z-10 rounded-[2rem] blur-2xl"
          >
          </div>

          <div
            class="bg-surface text-ink border-surface-soft relative rounded-[1.75rem] border p-7 shadow-[0_30px_80px_-20px_rgba(0,0,0,0.4)] sm:p-9"
          >
            <div class="mb-7 flex items-start justify-between gap-4">
              <div>
                <p class="alf-eyebrow text-accent-deep">Quick Application</p>
                <h2
                  class="font-display text-content-xl text-ink mt-2 leading-[1.05]"
                >
                  Check your options<br /> in 60 seconds.
                </h2>
              </div>
              <div
                aria-hidden="true"
                class="bg-ink text-surface grid h-12 w-12 shrink-0 place-items-center rounded-full"
              >
                <svg
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M5 12h14M13 5l7 7-7 7"></path>
                </svg>
              </div>
            </div>

            <form
              class="space-y-4"
              data-alf-lead-form
              action="/api/lead"
              method="post"
            >
              <div>
                <label for="lead-name" class="sr-only">Full Name</label>
                <input
                  id="lead-name"
                  name="name"
                  type="text"
                  required
                  placeholder="Full name"
                  class="alf-input"
                  autocomplete="name"
                />
              </div>
              <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                <div>
                  <label for="lead-phone" class="sr-only">Phone Number</label>
                  <input
                    id="lead-phone"
                    name="phone"
                    type="tel"
                    required
                    placeholder="Phone"
                    class="alf-input"
                    autocomplete="tel"
                  />
                </div>
                <div>
                  <label for="lead-email" class="sr-only">Email</label>
                  <input
                    id="lead-email"
                    name="email"
                    type="email"
                    required
                    placeholder="Email"
                    class="alf-input"
                    autocomplete="email"
                  />
                </div>
              </div>
              <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                <div>
                  <label for="lead-vehicle" class="sr-only">Vehicle Type</label>
                  <select
                    id="lead-vehicle"
                    name="vehicle"
                    required
                    class="alf-input bg-[url('data:image/svg+xml;utf8,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%2212%22 height=%228%22 viewBox=%220 0 12 8%22 fill=%22none%22 stroke=%22%236b665e%22 stroke-width=%221.8%22 stroke-linecap=%22round%22 stroke-linejoin=%22round%22><polyline points=%221 1 6 6 11 1%22/></svg>')] appearance-none bg-[right_1rem_center] bg-no-repeat pr-10"
                  >
                    <option value="">Vehicle type</option>
                    <option value="new">New vehicle</option>
                    <option value="used">Used vehicle</option>
                    <option value="refinance">Refinance existing</option>
                    <option value="commercial">Commercial / fleet</option>
                  </select>
                </div>
                <div>
                  <label for="lead-credit" class="sr-only">Credit Range</label>
                  <select
                    id="lead-credit"
                    name="credit"
                    required
                    class="alf-input bg-[url('data:image/svg+xml;utf8,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%2212%22 height=%228%22 viewBox=%220 0 12 8%22 fill=%22none%22 stroke=%22%236b665e%22 stroke-width=%221.8%22 stroke-linecap=%22round%22 stroke-linejoin=%22round%22><polyline points=%221 1 6 6 11 1%22/></svg>')] appearance-none bg-[right_1rem_center] bg-no-repeat pr-10"
                  >
                    <option value="">Credit range</option>
                    <option value="excellent">Excellent (740+)</option>
                    <option value="good">Good (670–739)</option>
                    <option value="fair">Fair (580–669)</option>
                    <option value="rebuild">Rebuilding (&lt; 580)</option>
                  </select>
                </div>
              </div>

              <button type="submit" class="alf-btn alf-btn-primary mt-2 w-full">
                Check My Options
                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M5 12h14M13 5l7 7-7 7"></path>
                </svg>
              </button>

              <p
                class="text-muted flex items-center justify-center gap-2 pt-1 text-[0.75rem]"
              >
                <svg
                  width="13"
                  height="13"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <rect x="3" y="11" width="18" height="11" rx="2"></rect>
                  <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
                No obligation · Secure SSL application
              </p>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom transition -->
  <div
    aria-hidden="true"
    class="bg-surface border-surface/40 absolute inset-x-0 bottom-0 h-8 border-t"
  >
  </div>
</section>

<script>
  const focusLeadName = () => {
    const input = document.querySelector<HTMLInputElement>("#lead-name");
    if (!input) return;

    input.focus({ preventScroll: true });
  };

  const scheduleLeadNameFocus = () => {
    requestAnimationFrame(focusLeadName);
    window.setTimeout(focusLeadName, 150);
    window.setTimeout(focusLeadName, 450);
  };

  const prefillLeadService = () => {
    const params = new URLSearchParams(window.location.search);
    const service = params.get("service");
    if (!service) return;

    const allowedServices = new Set(["new", "used", "refinance", "commercial"]);
    if (!allowedServices.has(service)) return;

    const select = document.querySelector<HTMLSelectElement>("#lead-vehicle");
    if (!select) return;

    select.value = service;
    select.dispatchEvent(new Event("change", { bubbles: true }));
  };

  function focusLeadFormFromHash() {
    if (window.location.hash !== "#lead-form") return;

    scheduleLeadNameFocus();
  }

  document.addEventListener("astro:page-load", () => {
    prefillLeadService();
    focusLeadFormFromHash();

    if (window.__alfLeadFormHashFocusBound) return;
    window.__alfLeadFormHashFocusBound = true;
    window.addEventListener("hashchange", focusLeadFormFromHash);
    document.addEventListener("click", (event) => {
      const link = (event.target as Element | null)?.closest<HTMLAnchorElement>(
        'a[href$="#lead-form"]',
      );
      if (!link) return;

      scheduleLeadNameFocus();
    });
  });
</script>
