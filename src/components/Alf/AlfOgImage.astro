---
import { Picture } from "astro:assets";
import carImage from "@/assets/images/cars/car3.webp";
import { BUSINESS } from "@/data/client";

interface Props {
  caption?: string;
}

const { caption = "Lower monthly payments. More room in your budget." } =
  Astro.props as Props;
---

<section
  aria-label="Open graph image preview"
  class="font-body bg-ink text-surface relative h-[630px] w-[1200px] overflow-hidden"
>
  <Picture
    src={carImage}
    alt=""
    formats={["avif", "webp"]}
    loading="eager"
    widths={[1200, 1600, 1920]}
    sizes="1200px"
    class="absolute inset-0 h-full w-full object-cover object-center"
  />

  <div
    class="absolute inset-0 bg-[linear-gradient(90deg,rgba(13,20,23,0.95)_0%,rgba(13,20,23,0.82)_38%,rgba(13,20,23,0.36)_70%,rgba(13,20,23,0.12)_100%)]"
  >
  </div>
  <div
    class="absolute inset-0 bg-[linear-gradient(0deg,rgba(8,35,41,0.76)_0%,rgba(8,35,41,0.12)_46%,rgba(8,35,41,0)_100%)]"
  >
  </div>

  <div
    class="relative flex h-full flex-col justify-between px-[76px] py-[58px]"
  >
    <div class="flex items-center gap-4">
      <span
        class="font-display bg-surface text-ink grid h-[70px] w-[70px] place-items-center rounded-full text-[42px] leading-none"
      >
        <span class="-mt-1 italic">a</span>
      </span>
      <div class="flex flex-col">
        <span class="font-display text-[34px] leading-none tracking-normal">
          Alberta Leasing
        </span>
        <span
          class="text-surface/72 mt-2 text-[15px] font-bold tracking-[0.18em] uppercase"
        >
          & Financing - AB
        </span>
      </div>
    </div>

    <div class="max-w-[760px]">
      <p
        class="text-accent-bright mb-5 text-[24px] font-bold tracking-[0.16em] uppercase"
      >
        Vehicle financing across Alberta
      </p>
      <h1
        class="font-display text-surface text-[82px] leading-[0.98] font-semibold tracking-normal"
      >
        {caption}
      </h1>
      <div class="mt-9 flex items-center gap-5">
        <span
          class="bg-accent text-surface rounded-full px-7 py-4 text-[22px] leading-none font-extrabold tracking-normal"
        >
          Apply in minutes
        </span>
        <span class="text-surface/82 text-[24px] font-semibold">
          Call {BUSINESS.phoneFormatted}
        </span>
      </div>
    </div>
  </div>
</section>
