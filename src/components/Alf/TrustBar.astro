---
const partners = [
  { name: "RBC", category: "Bank" },
  { name: "Scotiabank", category: "Bank" },
  { name: "TD Auto Finance", category: "Lender" },
  { name: "Servus Credit Union", category: "Credit Union" },
  { name: "ATB Financial", category: "Bank" },
  { name: "iA Auto Finance", category: "Lender" },
  { name: "Coast Capital", category: "Credit Union" },
  { name: "Canadian Western Bank", category: "Bank" },
];
const loop = [...partners, ...partners];
---

<section
  aria-labelledby="trust-bar-title"
  class="relative bg-bone border-y border-line-soft py-10 lg:py-14"
>
  <div class="mx-auto max-w-[88rem] px-5 lg:px-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      <div class="lg:col-span-3">
        <p id="trust-bar-title" class="alf-eyebrow">Lender Network</p>
        <p
          class="mt-3 font-display text-content-l text-ink leading-tight max-w-[14rem]"
        >
          Backed by Alberta&rsquo;s top
          <span class="italic text-primary">banks &amp; lenders.</span>
        </p>
      </div>

      <div
        class="lg:col-span-9 relative overflow-hidden [mask-image:linear-gradient(to_right,transparent,black_8%,black_92%,transparent)]"
      >
        <ul class="flex gap-12 lg:gap-16 alf-marquee w-max">
          {
            loop.map((p) => (
              <li class="flex items-center gap-3 shrink-0">
                <span class="font-display text-content-l text-ink/80 tracking-tight whitespace-nowrap">
                  {p.name}
                </span>
                <span class="text-[0.65rem] uppercase tracking-[0.2em] text-muted border border-line-soft rounded-full px-2 py-0.5 whitespace-nowrap">
                  {p.category}
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
