---
import { Picture } from "astro:assets";
import advisorImg from "@/assets/images/cars/car1.webp";

const reasons = [
  {
    title: "Personalized Solutions",
    desc: "No template offers — every plan is built around your goals, income, and credit picture.",
    icon: "user",
  },
  {
    title: "Fast Response Times",
    desc: "Real humans respond in under an hour during business hours. Most files close in days.",
    icon: "zap",
  },
  {
    title: "Competitive Lender Network",
    desc: "We shop your file across 20+ Alberta banks, credit unions, and specialist auto lenders.",
    icon: "shield",
  },
  {
    title: "Flexible Terms",
    desc: "From 24 to 84 months, weekly or monthly, balloon options — structured to your cashflow.",
    icon: "sliders",
  },
  {
    title: "Friendly Local Support",
    desc: "Calgary-based advisors who actually pick up the phone. No call-centre runaround.",
    icon: "phone",
  },
  {
    title: "All Credit Situations",
    desc: "First-time buyer, rebuilding credit, new to Canada — we've placed thousands like you.",
    icon: "heart",
  },
];

const icons: Record<string, string> = {
  user: "M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2 M12 7a4 4 0 1 1-8 0 4 4 0 0 1 8 0",
  zap: "M13 2L3 14h9l-1 8 10-12h-9l1-8z",
  shield: "M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z",
  sliders:
    "M4 21v-7 M4 10V3 M12 21v-9 M12 8V3 M20 21v-5 M20 12V3 M1 14h6 M9 8h6 M17 16h6",
  phone:
    "M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z",
  heart:
    "M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z",
};
---

<section
  id="why-us"
  aria-labelledby="why-title"
  class="bg-surface relative overflow-hidden py-20 lg:py-28"
>
  <div class="mx-auto max-w-[88rem] px-5 lg:px-10">
    <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-12 lg:gap-14">
      <!-- LEFT: image -->
      <div class="lg:col-span-5">
        <div class="relative">
          <!-- decorative offset block -->
          <div
            aria-hidden="true"
            class="bg-accent absolute -top-4 -left-4 hidden h-32 w-32 rounded-[1.5rem] sm:block"
          >
          </div>

          <div
            class="relative aspect-[4/5] overflow-hidden rounded-[1.75rem] sm:aspect-[5/6]"
          >
            <Picture
              src={advisorImg}
              alt="Burgundy Mazda convertible financed through Alberta Lease Finance"
              formats={["avif", "webp"]}
              widths={[400, 600, 800, 1000]}
              sizes="(min-width: 1024px) 40vw, 90vw"
              class="h-full w-full object-cover"
            />
            <div
              class="from-ink/40 absolute inset-0 bg-gradient-to-t via-transparent to-transparent"
            >
            </div>
          </div>

          <!-- Floating testimonial badge -->
          <div
            class="bg-paper border-line-soft absolute -right-2 -bottom-6 max-w-[18rem] rounded-2xl border p-5 shadow-[0_25px_60px_-20px_rgba(13,20,23,0.35)] sm:-right-6"
          >
            <div class="mb-3 flex items-center gap-1">
              {
                Array.from({ length: 5 }).map(() => (
                  <svg
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    class="text-gold"
                    aria-hidden="true"
                  >
                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26" />
                  </svg>
                ))
              }
            </div>
            <p class="font-display text-ink text-[0.95rem] leading-snug italic">
              &ldquo;Saved $164 a month on my truck loan. Whole thing took two
              days.&rdquo;
            </p>
            <p
              class="text-muted mt-3 text-[0.75rem] font-semibold tracking-[0.18em] uppercase"
            >
              — Marcus T. · Red Deer
            </p>
          </div>
        </div>
      </div>

      <!-- RIGHT: content -->
      <div class="lg:col-span-7">
        <p class="alf-eyebrow">Why Choose Us</p>
        <h2
          id="why-title"
          class="font-display text-section-xl text-ink mt-5 max-w-[20ch] leading-[1.05]"
        >
          Why Alberta drivers choose
          <span class="text-primary italic">us first.</span>
        </h2>
        <p class="text-body-l text-graphite mt-5 max-w-[34rem]">
          We&rsquo;re local, independent, and obsessed with getting you a better
          payment than you came in with. Here&rsquo;s what that looks like.
        </p>

        <ul class="mt-10 grid grid-cols-1 gap-x-8 gap-y-7 sm:grid-cols-2">
          {
            reasons.map((r) => (
              <li class="flex gap-4">
                <span class="bg-primary-soft text-primary grid h-11 w-11 shrink-0 place-items-center rounded-xl">
                  <svg
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    set:html={`<path d="${icons[r.icon]}"/>`}
                  />
                </span>
                <div>
                  <h3 class="font-display text-content-m text-ink leading-tight">
                    {r.title}
                  </h3>
                  <p class="text-body-m text-graphite mt-1.5 leading-snug">
                    {r.desc}
                  </p>
                </div>
              </li>
            ))
          }
        </ul>

        <div class="mt-10 flex flex-wrap gap-3">
          <a href="#lead-form" class="alf-btn alf-btn-primary">
            Speak With An Advisor
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M5 12h14M13 5l7 7-7 7"></path>
            </svg>
          </a>
          <!-- <a href="#lead-form" class="alf-btn alf-btn-ghost">
            Apply Online Instead
          </a> -->
        </div>
      </div>
    </div>
  </div>
</section>
